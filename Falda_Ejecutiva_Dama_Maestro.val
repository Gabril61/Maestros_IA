<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <version>0.7.3</version>
    <unit>cm</unit>
    <description>Matriz Maestra TextilFit - FALDA EJECUTIVA DAMA</description>
    <notes>Fase 3: Falda tubo/lápiz con ajuste sastre anatómico.</notes>
    <measurements>Maestro_Variables_IA.smis</measurements>
    <variables>
        <variable description="Holgura de cintura" formula="0.5" name="#holgura_cintura"/>
        <variable description="Holgura de cadera" formula="4" name="#holgura_cadera"/>
        <variable description="Pinza de cintura" formula="3" name="#pinza_cintura"/>
        <variable description="Ancho de pretina" formula="4" name="#ancho_pretina"/>
        <variable description="Ruedo prenda" formula="3" name="#ruedo_prenda"/>
        <variable description="Largo cierre" formula="15" name="#largo_cierre"/>
    </variables>
    <draftBlock name="Falda_Base">
