            <point angle="0" basePoint="107" id="111" length="((((@S_CONT_BUSTO + #holgura_busto)/4) + #compensacion_pinza_frente) &gt; (((@S_ANCHO_ESPALDA/2) - 1.5) + (@S_CONT_BUSTO / 16))) ? (((@S_CONT_BUSTO + #holgura_busto)/4) + #compensacion_pinza_frente) : (((@S_ANCHO_ESPALDA/2) - 1.5) + (@S_CONT_BUSTO / 16))" mx="-9.34635" my="1.29228" name="F_Costado_Sisa" type="endLine"/>























