            <point angle="AngleLine_F_Ancho_Pecho_F_Costado_Sisa - 15" basePoint="701" id="702" length="2" lineColor="black" lineType="none" lineWeight="0.35" mx="9.91156" my="8.54396" name="F_Sisa_Pinza_Inf_Ref" type="endLine"/>























