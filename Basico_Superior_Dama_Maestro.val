<?xml version="1.0" encoding="UTF-8"?>























<pattern>























    <version>0.7.3</version>























    <unit>cm</unit>























    <description>Patrón Maestro - Básico Superior Dama</description>























    <notes>Bloque fundacional para prendas superiores de dama. Estructura anatómica pura sin vistas, bolsillos ni cruces. Contiene Corte Princesa M.A.S.</notes>























    <measurements>Maestro_Variables_IA.smis</measurements>























    <variables>























        <variable description="Holgura de busto" formula="4" name="#holgura_busto"/>























        <variable description="Holgura de cintura" formula="6" name="#holgura_cintura"/>























        <variable description="Holgura de cadera" formula="8" name="#holgura_cadera"/>























        <variable description="Holgura de espalda" formula="2" name="#holgura_espalda"/>























        <variable description="Holgura de pecho" formula="2" name="#holgura_pecho"/>























        <variable description="Holgura de bicep" formula="4" name="#holgura_bicep"/>























        <variable description="Holgura de sisa" formula="10" name="#holgura_sisa"/>























        <variable description="Ruedo de prenda" formula="4" name="#ruedo_prenda"/>























        <variable description="Ajuste al largo de manga (+ o -)" formula="0" name="#ajuste_largo_manga"/>























        <variable description="Ajuste al largo total (+ o -)" formula="0" name="#ajuste_largo_prenda"/>























        <variable description="M.A.S. Sobrante puro sin compensar" formula="(((@S_CONT_BUSTO + #holgura_busto)/2)) - ((@G_CONT_CINTURA + #holgura_cintura)/2) - (2 * ((@S_CONT_BUSTO - @G_CONT_CINTURA)/10))" name="#sobrante_base"/>























        <variable description="M.A.S. Absorcion resuelta algebraicamente (gap = 60%)" formula="(#sobrante_base &gt; 0) ? (#sobrante_base / 2.8) : 0" name="#ancho_pierna_pinza"/>























        <variable description="Compensacion 60% del gap princesa" formula="#ancho_pierna_pinza * 1.2" name="#compensacion_pinza_espalda"/>























        <variable description="Compensacion del gap de la pinza de sisa delantera" formula="1.35" name="#compensacion_pinza_frente"/>























    </variables>























    <draftBlock name="Cuerpo_Principal">























        <calculation>























