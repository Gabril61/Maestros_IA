            <point angle="90" basePoint="301" id="1304" length="((@S_TALLE_DELANTERO &gt; @S_TALLE_TRASERO) ? (@S_TALLE_DELANTERO - @S_TALLE_TRASERO) : 0) + 1.5" lineColor="black" lineType="none" name="F_Ruedo_Altura" showPointName="false" type="endLine" />
