            <spline angle1="AngleLine_F_Hombro_F_Costado_Sisa - 15" angle2="180" color="black" id="33" length1="Line_F_Hombro_F_Costado_Sisa * 0.15" length2="Line_F_Hombro_F_Costado_Sisa * 0.25" lineWeight="0.7" penStyle="solidLine" point1="702" point4="5" type="simpleInteractive" />
