            <line firstPoint="300" id="305" lineColor="black" lineType="dashLine" lineWeight="0.35" secondPoint="302" />
            <point angle="0" basePoint="1" id="23" length="(@S_CONT_CUELLO / 6) + 1" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Cuello_Ancho" showPointName="true" type="endLine" />
            <point angle="270" basePoint="1" id="13" length="@S_ALTO_BUSTO" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Guia_Alto_Busto" showPointName="false" type="endLine" />
            <point angle="0" basePoint="13" id="14" length="@S_SEP_BUSTO / 2" lineColor="black" lineType="none" lineWeight="0.7" mx="0.1" my="0.1" name="F_APEX" showPointName="true" type="endLine" />
            <point angle="270" basePoint="1" id="24" length="(@S_CONT_CUELLO / 6) + 2" lineColor="black" lineType="none" lineWeight="0.35" mx="7.34463" my="-0.377668" name="F_Cuello_Prof" showPointName="true" type="endLine" />
            <line firstPoint="1" id="1020" lineColor="black" lineType="none" lineWeight="0.35" secondPoint="24" />
            <line firstPoint="1" id="1021" lineColor="black" lineType="none" lineWeight="0.35" secondPoint="23" />
            <point angle="0" basePoint="1" id="26" length="(@S_ANCHO_ESPALDA / 2)" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Guia_Hombro_X" showPointName="false" type="endLine" />
            <point angle="270" basePoint="26" id="27" length="4" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Guia_Hombro_Y" showPointName="false" type="endLine" />
            <line firstPoint="23" id="1000" lineColor="black" lineType="none" lineWeight="0.35" secondPoint="27" />
            <point angle="AngleLine_F_Cuello_Ancho_F_Guia_Hombro_Y" basePoint="23" id="28" length="(@S_ANCHO_HOMBRO - 3.5)" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Hombro" showPointName="true" type="endLine" />
            <line firstPoint="28" id="19999" lineColor="black" lineType="none" lineWeight="0.35" secondPoint="5" /><line firstPoint="23" id="29" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="28" />
            <point angle="270" basePoint="1" id="30" length="Line_F_Origen_F_Linea_Sisa / 2" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Mitad_Sisa_Y" showPointName="false" type="endLine" />
            <point angle="270" basePoint="28" id="1058" length="20" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Temp_Vert" showPointName="false" type="endLine" />
