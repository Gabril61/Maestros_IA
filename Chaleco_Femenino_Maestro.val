            <point angle="AngleLine_F_Hombro_F_Costado_Sisa - 18" basePoint="701" id="702" length="1.5" lineColor="black" lineType="none" lineWeight="0.35" mx="4.4496" my="-1.87709" name="F_Sisa_Pinza_Inf" showPointName="true" type="endLine" />
