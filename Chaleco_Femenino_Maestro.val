            <point angle="90" basePoint="1200" id="200" length="(@S_TALLE_DELANTERO &gt; @S_TALLE_TRASERO) ? (@S_TALLE_DELANTERO - @S_TALLE_TRASERO) : 0" lineColor="black" lineType="none" lineWeight="0.35" mx="0.1" my="0.1" name="F_Costado_Real" showPointName="true" type="endLine" />
