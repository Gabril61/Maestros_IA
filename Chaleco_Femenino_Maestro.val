            <line firstPoint="28" secondPoint="701" id="9999" lineColor="black" lineType="none" lineWeight="0.35" /><spline angle1="AngleLine_F_Hombro_F_Costado_Sisa - 25" angle2="AngleLine_F_Hombro_F_Costado_Sisa + 180 - 15" color="black" id="32" length1="Line_F_Hombro_F_Costado_Sisa * 0.25" length2="Line_F_Hombro_F_Costado_Sisa * 0.1" lineWeight="0.7" point1="28" point4="31" type="simpleInteractive" />
