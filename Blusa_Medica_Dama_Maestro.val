            <point angle="270" basePoint="104" id="105" length="4" name="F_Caida_Hombro" type="endLine"/>
            <line firstPoint="101" id="106" secondPoint="105"/>
            <point angle="0" basePoint="109" id="110" length="(@S_ANCHO_ESPALDA + #holgura_pecho)/2" name="F_Ancho_Pecho" type="endLine"/>
            <point angle="0" basePoint="107" id="111" length="((@S_CONT_BUSTO + #holgura_busto)/4)" name="F_Costado_Sisa" type="endLine"/>
