<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <version>0.7.3</version>
    <unit>cm</unit>
    <description>Patrón Maestro - Scrub Top Médico Caballero</description>
    <notes>Conjunto Médico: Scrub Top para caballero. Cuello en V cruzado clásico, aberturas laterales y bolsillos inferiores.</notes>
    <measurements/>
    <variables>
        <variable description="Contorno de cuello" formula="36.5" name="@S_CONT_CUELLO"/>
        <variable description="Ancho de espalda" formula="36" name="@S_ANCHO_ESPALDA"/>
        <variable description="Talle delantero" formula="44" name="@S_TALLE_DELANTERO"/>
        <variable description="Talle trasero" formula="42" name="@S_TALLE_TRASERO"/>
        <variable description="Contorno de busto" formula="92" name="@S_CONT_BUSTO"/>
        <variable description="Contorno de cadera baja" formula="98" name="@G_CONT_CADERA_BAJA"/>
        <variable description="Largo total de la bata" formula="100" name="@G_LARGO_PRENDA"/>
        <variable description="Contorno del brazo" formula="28" name="@S_CONT_BICEP"/>
        <variable description="Largo de manga" formula="60" name="@S_LARGO_MANGA"/>
        <variable description="Holgura de busto" formula="6" name="#holgura_busto"/>
        <variable description="Holgura de cadera" formula="10" name="#holgura_cadera"/>
        <variable description="Holgura de espalda" formula="1.5" name="#holgura_espalda"/>
        <variable description="Holgura de pecho" formula="-1.5" name="#holgura_pecho"/>
        <variable description="Holgura de bicep" formula="5" name="#holgura_bicep"/>
    </variables>
    <draftBlock name="Bata_Elegante">
        <calculation>
            <point id="100" mx="0.1" my="0.1" name="F_Origen" type="single" x="0" y="0"/>
            <point angle="270" basePoint="100" id="102" length="(@S_CONT_CUELLO/6) + 2" name="F_Escote_Alto" type="endLine"/>
            <point angle="270" basePoint="100" id="107" length="(@S_ANCHO_ESPALDA/2) + 4" name="F_Nivel_Sisa" type="endLine"/>
            <point angle="270" basePoint="100" id="109" length="((@S_ANCHO_ESPALDA/2)+4)/2" name="F_Nivel_Pecho" type="endLine"/>
            <point angle="270" basePoint="100" id="116" length="@S_TALLE_DELANTERO" name="F_Nivel_Cintura" type="endLine"/>
            <point angle="270" basePoint="100" id="118" length="@S_TALLE_DELANTERO + 25" name="F_Nivel_Largo" type="endLine"/>
            <point angle="0" basePoint="100" id="101" length="(@S_CONT_CUELLO/6) + 1" name="F_Escote_Ancho" type="endLine"/>
            <point angle="180" basePoint="102" id="152" length="1" name="F_Cruce_Pecho" type="endLine"/>
