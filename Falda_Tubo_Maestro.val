            <line firstPoint="110" id="702" lineColor="black" lineType="none" lineWeight="0.35" secondPoint="111"/>
            <point angle="0" basePoint="101" id="112" length="#ancho_eje_corte" mx="0.1" my="0.1" name="F_Cadera_Eje" showPointName="true" type="endLine"/>
            <point angle="0" basePoint="102" id="113" length="#ancho_eje_corte" mx="0.1" my="0.1" name="F_Largo_Eje" showPointName="true" type="endLine"/>
            <point angle="180" basePoint="113" id="114" length="#entalle_tubo * #proporcion_corte_vertical" mx="-4.59277" my="-6.87573" name="F_Largo_Eje_Entalle" showPointName="true" type="endLine"/>
            <line firstPoint="112" id="134" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="114"/>
            <point angle="540 - AngleLine_F_Cadera_Costado_F_Largo_Costado_Entalle" basePoint="105" id="115" length="#ruedo_prenda" mx="0.1" my="0.1" name="F_Ruedo_Costado_Ext" showPointName="true" type="endLine"/>
            <point angle="270" basePoint="102" id="116" length="#ruedo_prenda" mx="0.1" my="0.1" name="F_Ruedo_Centro_Ext" showPointName="true" type="endLine"/>
            <point angle="540 - AngleLine_F_Cadera_Eje_F_Largo_Eje_Entalle" basePoint="114" id="117" length="#ruedo_prenda" mx="-3.70494" my="2.1293" name="F_Ruedo_Eje_Ext" showPointName="true" type="endLine"/>
            <spline angle1="270" angle2="90" color="black" id="120" length1="Line_F_Pinza_Izq_F_Pinza_Fin * 0.3" length2="Line_F_Pinza_Izq_F_Pinza_Fin * 0.3" lineWeight="0.35" penStyle="solidLine" point1="109" point4="111" type="simpleInteractive"/>
            <spline angle1="90" angle2="270" color="black" id="121" length1="Line_F_Pinza_Der_F_Pinza_Fin * 0.3" length2="Line_F_Pinza_Der_F_Pinza_Fin * 0.3" lineWeight="0.35" penStyle="solidLine" point1="111" point4="110" type="simpleInteractive"/>
            <spline angle1="270" angle2="90" color="black" id="122" length1="Line_F_Cintura_Costado_F_Cadera_Costado * 0.3" length2="Line_F_Cintura_Costado_F_Cadera_Costado * 0.3" lineWeight="0.35" penStyle="solidLine" point1="107" point4="103" type="simpleInteractive"/>
            <line firstPoint="100" id="130" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="102"/>
            <line firstPoint="100" id="131" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="109"/>
            <line firstPoint="110" id="132" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="107"/>
            <line firstPoint="111" id="133" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="112"/>
            <line firstPoint="102" id="136" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="114"/>
            <line firstPoint="114" id="137" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="105"/>
            <line firstPoint="102" id="138" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="116"/>
            <line firstPoint="114" id="139" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="117"/>
            <line firstPoint="105" id="140" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="115"/>
            <line firstPoint="116" id="141" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="117"/>
            <line firstPoint="117" id="142" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="115"/>
            <point id="200" mx="-8.14405" my="2.1293" name="T_Origen" type="single" x="60" y="0"/>
            <point angle="270" basePoint="200" id="201" length="@G_ALTO_CADERA" mx="0.1" my="0.1" name="T_Nivel_Cadera" showPointName="true" type="endLine"/>
            <point angle="270" basePoint="200" id="202" length="#largo_falda + #ajuste_largo_prenda" mx="0.1" my="0.1" name="T_Nivel_Largo" showPointName="true" type="endLine"/>
            <point angle="0" basePoint="201" id="203" length="(@G_CONT_CADERA_BAJA + #holgura_cadera) / 4" mx="0.1" my="0.1" name="T_Cadera_Costado" showPointName="true" type="endLine"/>
