<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <version>0.7.3</version>
    <unit>cm</unit>
    <description>Patron Maestro - Falda Tubo de Tiro Alto con Cortes Longitudinales</description>
    <notes>Falda tubo (pencil skirt) entallada con costuras longitudinales y pinzas de cintura integradas en los cortes. Totalmente parametrica.</notes>
    <measurements>Maestro_Variables_IA.smis</measurements>
    <variables>
        <variable description="Largo base de la falda a la rodilla" formula="60" name="#largo_falda"/>
        <variable description="Ajuste MTM al largo total (+ o -)" formula="0" name="#ajuste_largo_prenda"/>
        <variable description="Holgura total de la cintura (ajuste maximo)" formula="1.0" name="#holgura_cintura"/>
        <variable description="Holgura total de la cadera (ajuste maximo)" formula="2.0" name="#holgura_cadera"/>
        <variable description="Proporcion de ubicacion de costura vertical (58% de ancho, mas hacia el costado)" formula="0.58" name="#proporcion_corte_vertical"/>
        <variable description="Entalle en el ruedo del costado para efecto tubo" formula="2.0" name="#entalle_tubo"/>
        <variable description="Largo donde se desvanece el entalle delantero en la costura" formula="10.0" name="#largo_curva_delantera"/>
        <variable description="Largo donde se desvanece el entalle trasero en la costura" formula="14.0" name="#largo_curva_trasera"/>
        <variable description="Altura del tajo/abertura trasera para caminar" formula="18.0" name="#alto_abertura"/>
        <variable description="Ancho de la pestaña de la abertura trasera" formula="4.0" name="#ancho_abertura"/>
        <variable description="Ancho del dobladillo inferior (ruedo)" formula="4.0" name="#ruedo_prenda"/>
        <variable description="Entalle en cintura centro espalda para curva lumbar" formula="1.2" name="#entalle_trasero_cb"/>
        <variable description="Ancho constante del panel central (alineacion vertical perfecta)" formula="((@G_CONT_CADERA_BAJA + #holgura_cadera) / 4) * #proporcion_corte_vertical" name="#ancho_eje_corte"/>
        <variable description="Diferencia total cintura-cadera para media falda" formula="((@G_CONT_CADERA_BAJA + #holgura_cadera)/2) - ((@G_CONT_CINTURA + #holgura_cintura)/2)" name="#sobrante_base"/>
        <variable description="Entalle asignado al costado de la falda (40%)" formula="#sobrante_base * 0.4" name="#entalle_costado"/>
        <variable description="Sobrante total a absorber en las costuras longitudinales" formula="#sobrante_base - #entalle_costado" name="#total_pinzas"/>
        <variable description="Entalle absorbido en la costura vertical delantera (40% de pinzas)" formula="#total_pinzas * 0.4" name="#pinza_delantera"/>
        <variable description="Entalle absorbido en la costura vertical trasera (60% de pinzas)" formula="#total_pinzas * 0.6" name="#pinza_trasera"/>
    </variables>
    <draftBlock name="Cuerpo_Principal">
        <calculation>
            <point id="100" mx="0.1" my="0.1" name="F_Origen" type="single" x="0" y="0"/>
            <point angle="270" basePoint="100" id="101" length="@G_ALTO_CADERA" mx="0.1" my="0.1" name="F_Nivel_Cadera" showPointName="true" type="endLine"/>
            <point angle="270" basePoint="100" id="102" length="#largo_falda + #ajuste_largo_prenda" mx="0.1" my="0.1" name="F_Nivel_Largo" showPointName="true" type="endLine"/>
            <point angle="0" basePoint="101" id="103" length="(@G_CONT_CADERA_BAJA + #holgura_cadera) / 4" mx="0.1" my="0.1" name="F_Cadera_Costado" showPointName="true" type="endLine"/>
            <point angle="0" basePoint="102" id="104" length="(@G_CONT_CADERA_BAJA + #holgura_cadera) / 4" mx="0.1" my="0.1" name="F_Largo_Costado" showPointName="true" type="endLine"/>
            <point angle="180" basePoint="104" id="105" length="#entalle_tubo" mx="9.10504" my="-1.42198" name="F_Largo_Costado_Entalle" showPointName="true" type="endLine"/>
            <line firstPoint="103" id="135" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="105"/>
            <point angle="0" basePoint="100" id="106" length="((@G_CONT_CINTURA + #holgura_cintura) / 4) + #pinza_delantera" mx="6.31474" my="1.62198" name="F_Ancho_Cintura_Temp" showPointName="true" type="endLine"/>
            <point angle="90" basePoint="106" id="107" length="1.0" mx="3.14396" my="-3.70494" name="F_Cintura_Costado" showPointName="true" type="endLine"/>
            <line firstPoint="107" id="703" lineColor="black" lineType="none" lineWeight="0.35" secondPoint="103"/>
            <point angle="0" basePoint="100" id="108" length="#ancho_eje_corte" mx="-8.39771" my="-6.87573" name="F_Cintura_Eje" showPointName="true" type="endLine"/>
            <point angle="180" basePoint="108" id="109" length="#pinza_delantera / 2" mx="-7.76355" my="3.27079" name="F_Pinza_Izq" showPointName="true" type="endLine"/>
            <point angle="0" basePoint="108" id="110" length="#pinza_delantera / 2" mx="0.607326" my="-8.14405" name="F_Pinza_Der" showPointName="true" type="endLine"/>
            <point angle="270" basePoint="108" id="111" length="#largo_curva_delantera" mx="0.1" my="0.1" name="F_Pinza_Fin" showPointName="true" type="endLine"/>
