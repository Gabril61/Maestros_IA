<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <version>0.7.3</version>
    <unit>cm</unit>
    <description>Bata Medica Dama - Corte Princesa</description>
    <notes>Correccion Geometrica: Altura de busto fijada, pinzas rectas para evitar bucles, escote trasero invertido corregido.</notes>
    <measurements/>
