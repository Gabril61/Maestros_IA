            <point angle="270" basePoint="104" id="10500" length="4" mx="1.95655" my="-0.489051" name="F_Guia_Caida_Hombro" type="endLine"/>
            <point firstPoint="101" id="105" length="sqrt((((@S_ANCHO_ESPALDA + #holgura_espalda)/2) - ((@S_CONT_CUELLO/6) + 1.5)) * (((@S_ANCHO_ESPALDA + #holgura_espalda)/2) - ((@S_CONT_CUELLO/6) + 1.5)) + 9)" mx="2.01428" my="-5.16482" name="F_Caida_Hombro" secondPoint="10500" type="alongLine"/>
