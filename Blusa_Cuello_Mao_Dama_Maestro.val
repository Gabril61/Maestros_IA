            <point angle="0" basePoint="116" id="1190" length="(((@S_CONT_BUSTO + #holgura_busto)/4) + #compensacion_pinza_frente) - ((@S_CONT_BUSTO - @G_CONT_CINTURA)/10)" mx="-10.2213" my="-2.59643" name="F_Costado_Cintura_Ref" type="endLine"/>
            <line firstPoint="111" id="11901" lineColor="black" lineType="none" secondPoint="1190"/>
            <point angle="AngleLine_F_Costado_Sisa_F_Costado_Cintura_Ref" basePoint="111" id="119" length="sqrt(((@S_TALLE_TRASERO - ((@S_CONT_SISA / 2) + (#holgura_sisa / 2))) * (@S_TALLE_TRASERO - ((@S_CONT_SISA / 2) + (#holgura_sisa / 2)))) + (((@S_CONT_BUSTO - @G_CONT_CINTURA)/10) * ((@S_CONT_BUSTO - @G_CONT_CINTURA)/10)))" mx="-10.2213" my="-2.59643" name="F_Costado_Cintura" type="endLine"/>
            <point angle="0" basePoint="118" id="1210" length="((@G_CONT_CADERA_BAJA + #holgura_cadera)/4)" mx="-3.51557" my="2.07367" name="F_Costado_Ruedo_Ref" type="endLine"/>
